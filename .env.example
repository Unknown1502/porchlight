# ---- model ----
PORCHLIGHT_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-west-2

# Set OFFLINE=1 to run the graph with the deterministic stub model (no AWS calls,
# no cost). Use this for development; unset it for the demo and the eval run.
PORCHLIGHT_OFFLINE=1

# ---- jurisdiction ----
PORCHLIGHT_PACK=in           # in | us

# ---- community scope (AgentCore Memory namespace) ----
PORCHLIGHT_COMMUNITY_ID=demo-coalition

# ---- AgentCore (leave blank to use the local store + local policy shim) ----
AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_URL=
AGENTCORE_POLICY_ENGINE_ID=

# ---- optional enrichment feeds ----
# Free account required: https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=

# ---- HTTP boundary auth (leave both blank for a local, single-operator demo) ----
# Shared secret for POST /reports. Blank = the ingest webhook is open.
PORCHLIGHT_INGEST_TOKEN=

# Per-coordinator shared secrets for the approval endpoints: "name:secret" pairs,
# comma-separated. Blank = /approve trusts the X-Coordinator header's name alone
# (dev auth, not identity — see README Limitations). Example:
# PORCHLIGHT_COORDINATOR_CREDENTIALS=Priya Nair:change-me,Sam Osei:change-me-too
